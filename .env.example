# ---------- App ----------
APP_URL="http://localhost:3000"            # public storefront origin (canonical URLs, sitemaps)
ADMIN_ORIGIN="http://localhost:5173"       # admin app origin allowed by CORS (comma-separated for several)
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
