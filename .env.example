# ---------- Providers (mock in development) ----------
PAYMENT_MODE="mock"                        # mock | sandbox | live
SMS_PROVIDER="mock"                        # mock | ssl-wireless (adapter stub)
EMAIL_PROVIDER="mock"                      # mock | smtp
STORAGE_DRIVER="local"                     # local | s3
STORAGE_LOCAL_DIR="./storage/uploads"
# S3-compatible storage (Cloudflare R2, AWS S3, MinIO) when STORAGE_DRIVER=s3
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# Payment gateway credentials (sandbox) — leave empty to use the mock adapter
